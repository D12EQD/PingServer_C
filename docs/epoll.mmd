        EE_READ["on_read<br/>处理读事件"]
        EE_WRITE["on_write<br/>处理写事件"]
        EE_ERROR["on_error<br/>处理异常"]
        
        EE --> EE_HANDLE
        EE_HANDLE --> EE_DISPATCH
        EE_DISPATCH --> EE_ACCEPT
        EE_DISPATCH --> EE_READ
        EE_DISPATCH --> EE_WRITE
        EE_DISPATCH --> EE_ERROR
    end
    
    subgraph "connection.h - 连接管理器"
        CONN["connection_t"]
        CONN_LIFE["connection_create<br/>connection_destroy"]
        CONN_IO["connection_recv<br/>connection_send"]
        CONN_STATE["connection_set_state<br/>connection_get_state"]
        CONN_BUF["读写缓冲管理"]
        
        CONN --> CONN_LIFE
        CONN --> CONN_IO
        CONN --> CONN_STATE
        CONN --> CONN_BUF
    end
    
    APP --> TS_API
    TS_RUN --> EE_HANDLE
