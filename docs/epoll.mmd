graph TB
    subgraph "应用层"
        APP["main.c<br/>业务逻辑"]
    end
    
    subgraph "tcp_server.h - 全局协调器"
        TS["tcp_server_t"]
        TS_INIT["tcp_server_create<br/>tcp_server_start"]
        TS_RUN["tcp_server_run<br/>核心事件循环"]
        TS_API["tcp_server_send<br/>tcp_server_close_connection<br/>业务接口"]
        TS --> TS_INIT
        TS --> TS_RUN
        TS --> TS_API
    end
    
    subgraph "epoll_event.h - 事件分发器"
        EE["epoll_event_t"]
        EE_HANDLE["epoll_event_handle<br/>事件处理总入口"]
        EE_DISPATCH["epoll_event_dispatch<br/>分发到具体handler"]
